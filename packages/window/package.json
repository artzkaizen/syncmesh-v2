{
  "name": "@syncmesh/window",
  "version": "0.0.0",
  "description": "Windowed reads for tables the server keeps: versioned row patches, the server's per-socket windows and the device's thin client",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@syncmesh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@syncmesh/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "dependencies": {
    "@syncmesh/kernel": "workspace:*",
    "@syncmesh/result": "workspace:*",
    "@syncmesh/temporal": "workspace:*",
    "@syncmesh/wire": "workspace:*"
  },
  "devDependencies": {
    "@syncmesh/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
