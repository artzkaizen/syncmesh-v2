{
  "name": "@syncmesh/transport",
  "version": "0.0.0",
  "description": "The transport port: framed links, the sync bridge, loopback",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@syncmesh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./transport-tests": {
      "@syncmesh/source": "./src/transport-tests/index.ts",
      "types": "./dist/transport-tests/index.d.ts",
      "default": "./dist/transport-tests/index.js"
    },
    "./test-fixtures": {
      "@syncmesh/source": "./src/test-fixtures/index.ts",
      "types": "./dist/test-fixtures/index.d.ts",
      "default": "./dist/test-fixtures/index.js"
    }
  },
  "dependencies": {
    "@syncmesh/engine": "workspace:*",
    "@syncmesh/kernel": "workspace:*",
    "@syncmesh/result": "workspace:*",
    "@syncmesh/schema": "workspace:*",
    "@syncmesh/temporal": "workspace:*",
    "@syncmesh/wire": "workspace:*"
  },
  "devDependencies": {
    "@syncmesh/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
