{
  "name": "@syncmesh/client",
  "version": "0.0.0",
  "description": "The mesh under createClient: options, surface and engine wiring; createMesh at ./internal for adapters and harnesses",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@syncmesh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "@syncmesh/source": "./src/harness.ts",
      "types": "./dist/harness.d.ts",
      "default": "./dist/harness.js"
    }
  },
  "dependencies": {
    "@syncmesh/docs": "workspace:*",
    "@syncmesh/drizzle": "workspace:*",
    "@syncmesh/engine": "workspace:*",
    "@syncmesh/kernel": "workspace:*",
    "@syncmesh/policy": "workspace:*",
    "@syncmesh/result": "workspace:*",
    "@syncmesh/schema": "workspace:*",
    "@syncmesh/sqlite-bun": "workspace:*",
    "@syncmesh/sqlite-node": "workspace:*",
    "@syncmesh/storage": "workspace:*",
    "@syncmesh/temporal": "workspace:*",
    "@syncmesh/transport": "workspace:*",
    "@syncmesh/wire": "workspace:*"
  },
  "devDependencies": {
    "@syncmesh/config": "workspace:*",
    "@syncmesh/relay": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-orm": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": "^1.0.0-rc.4"
  }
}
