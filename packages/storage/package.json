{
  "name": "@syncmesh/storage",
  "version": "0.0.0",
  "description": "SqliteDriver port and the one SQLite event store every driver runs",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@syncmesh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./driver-tests": {
      "@syncmesh/source": "./src/driver-tests/index.ts",
      "types": "./dist/driver-tests/index.d.ts",
      "default": "./dist/driver-tests/index.js"
    },
    "./doc-tables": {
      "@syncmesh/source": "./src/doc-tables.ts",
      "types": "./dist/doc-tables.d.ts",
      "default": "./dist/doc-tables.js"
    }
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "@syncmesh/engine": "workspace:*",
    "@syncmesh/kernel": "workspace:*",
    "@syncmesh/policy": "workspace:*",
    "@syncmesh/result": "workspace:*",
    "@syncmesh/schema": "workspace:*",
    "@syncmesh/temporal": "workspace:*",
    "@syncmesh/wire": "workspace:*"
  },
  "devDependencies": {
    "@syncmesh/config": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-orm": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": "^1.0.0-rc.4"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  }
}
