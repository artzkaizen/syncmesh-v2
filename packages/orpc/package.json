{
  "name": "@syncmesh/orpc",
  "version": "0.0.0",
  "description": "oRPC over a mesh: the context and role middlewares an authority's procedures use",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@syncmesh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "@syncmesh/source": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "dependencies": {
    "@orpc/client": "2.0.0-beta.31",
    "@orpc/contract": "2.0.0-beta.31",
    "@orpc/server": "2.0.0-beta.31",
    "@syncmesh/client": "workspace:*",
    "@syncmesh/drizzle": "workspace:*",
    "@syncmesh/kernel": "workspace:*",
    "@syncmesh/result": "workspace:*",
    "@syncmesh/schema": "workspace:*",
    "@syncmesh/storage": "workspace:*",
    "@syncmesh/window": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@syncmesh/cdc": "workspace:*",
    "@syncmesh/config": "workspace:*",
    "@syncmesh/engine": "workspace:*",
    "@syncmesh/postgres": "workspace:*",
    "@syncmesh/relay": "workspace:*",
    "@syncmesh/sqlite-bun": "workspace:*",
    "@syncmesh/temporal": "workspace:*",
    "@syncmesh/wire": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.9",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@syncmesh/relay": "workspace:*",
    "drizzle-orm": "^1.0.0-rc.4"
  },
  "peerDependenciesMeta": {
    "@syncmesh/relay": {
      "optional": true
    }
  }
}
