{
  "name": "@syncmesh/orpc",
  "version": "0.0.0",
  "description": "oRPC over a mesh: the context and role middlewares an authority's procedures use",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@syncmesh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@syncmesh/client": "workspace:*",
    "@syncmesh/drizzle": "workspace:*",
    "@syncmesh/kernel": "workspace:*",
    "@syncmesh/result": "workspace:*",
    "@syncmesh/schema": "workspace:*",
    "@syncmesh/storage": "workspace:*"
  },
  "devDependencies": {
    "@orpc/server": "2.0.0-beta.31",
    "@syncmesh/config": "workspace:*",
    "@syncmesh/engine": "workspace:*",
    "@syncmesh/relay": "workspace:*",
    "@syncmesh/sqlite-bun": "workspace:*",
    "@syncmesh/temporal": "workspace:*",
    "@syncmesh/wire": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-orm": "latest",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@orpc/server": "^2.0.0-beta.31",
    "@syncmesh/relay": "workspace:*",
    "drizzle-orm": ">=0.44"
  },
  "peerDependenciesMeta": {
    "@syncmesh/relay": {
      "optional": true
    }
  }
}
