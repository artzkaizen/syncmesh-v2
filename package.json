{
  "name": "syncmesh",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "adapters/*",
      "apps/*",
      "native/*",
      "tooling/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@types/bun": "^1.3.14",
      "fast-check": "^4.5.3"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "ci": "turbo run build typecheck test //#lint //#fmt:check",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "plan": "bun plan/tool/serve.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0"
}
