{
  "name": "syncmesh",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "adapters/*",
      "apps/*",
      "native/*",
      "tooling/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@types/bun": "^1.3.14",
      "fast-check": "^4.5.3",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
      "vite-plus": "0.3.0",
      "@types/node": "^24.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "ci": "vp check && vp run -r build && vp run -r typecheck && vp run -r test",
    "gen": "vp create package",
    "plan": "bun plan/tool/serve.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0"
}
