{
  "name": "syncmesh",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "adapters/*",
      "apps/*",
      "native/*",
      "tooling/*",
      "conformance",
      "examples",
      "bench"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@types/bun": "^1.3.14",
      "fast-check": "^4.5.3",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
      "vite-plus": "0.3.0",
      "@types/node": "^24.0.0",
      "temporal-polyfill": "^1.0.4"
    }
  },
  "type": "module",
  "scripts": {
    "bench": "bun run --cwd bench storage",
    "bench:join": "bun run --cwd bench join",
    "ci": "vp check && vp run -r build && vp run -r typecheck && vp run --concurrency-limit 2 -r test && node tooling/verify-node-consumer/bin/index.ts",
    "explore": "bun plan/tool/explorer.ts",
    "gen": "node tooling/create-package/bin/index.ts",
    "plan": "bun plan/tool/serve.ts",
    "test": "vp run --concurrency-limit 2 -r test",
    "verify": "node tooling/verify-node-consumer/bin/index.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "catalog:",
    "oxlint": "1.80.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0"
}
