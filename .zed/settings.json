{
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": { "tsdk": "node_modules/typescript/lib" }
      }
    }
  },
  "languages": {
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "node_modules/.bin/vp",
          "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "node_modules/.bin/vp",
          "arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
        }
      }
    }
  }
}
