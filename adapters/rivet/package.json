{
  "name": "@syncmesh/rivet",
  "version": "0.0.0",
  "description": "The relay room in a Rivet actor: c.db as a driver, the actor's raw WebSocket as a RelaySocket",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@syncmesh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@syncmesh/engine": "workspace:*",
    "@syncmesh/relay": "workspace:*",
    "@syncmesh/result": "workspace:*",
    "@syncmesh/storage": "workspace:*"
  },
  "devDependencies": {
    "@syncmesh/client": "workspace:*",
    "@syncmesh/config": "workspace:*",
    "@syncmesh/kernel": "workspace:*",
    "@syncmesh/schema": "workspace:*",
    "@syncmesh/sqlite-bun": "workspace:*",
    "@syncmesh/temporal": "workspace:*",
    "@syncmesh/wire": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-orm": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
