{
  "name": "@syncmesh/sqlite-bun",
  "version": "0.0.0",
  "description": "bun:sqlite driver for @syncmesh/storage",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@syncmesh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@syncmesh/engine": "workspace:*",
    "@syncmesh/result": "workspace:*",
    "@syncmesh/storage": "workspace:*"
  },
  "devDependencies": {
    "@syncmesh/config": "workspace:*",
    "@syncmesh/kernel": "workspace:*",
    "@syncmesh/temporal": "workspace:*",
    "@syncmesh/wire": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "bun": ">=1.2"
  }
}
