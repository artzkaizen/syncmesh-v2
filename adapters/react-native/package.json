{
  "name": "@syncmesh/react-native",
  "version": "0.0.0",
  "description": "What a mesh on a phone needs from the platform: the knocks, the entropy, the Ed25519 and the radio",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/entropy.ts",
    "./dist/entropy.js"
  ],
  "exports": {
    ".": {
      "@syncmesh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dev-server": {
      "@syncmesh/source": "./src/dev-server.ts",
      "types": "./dist/dev-server.d.ts",
      "default": "./dist/dev-server.js"
    },
    "./network": {
      "@syncmesh/source": "./src/network.ts",
      "types": "./dist/network.d.ts",
      "default": "./dist/network.js"
    },
    "./crypto": {
      "@syncmesh/source": "./src/crypto.ts",
      "types": "./dist/crypto.d.ts",
      "default": "./dist/crypto.js"
    },
    "./entropy": {
      "@syncmesh/source": "./src/entropy.ts",
      "types": "./dist/entropy.d.ts",
      "default": "./dist/entropy.js"
    },
    "./ble": {
      "@syncmesh/source": "./src/ble.ts",
      "types": "./dist/ble.d.ts",
      "default": "./dist/ble.js"
    },
    "./p2p": {
      "@syncmesh/source": "./src/p2p.ts",
      "types": "./dist/p2p.d.ts",
      "default": "./dist/p2p.js"
    },
    "./lan": {
      "@syncmesh/source": "./src/lan.ts",
      "types": "./dist/lan.d.ts",
      "default": "./dist/lan.js"
    }
  },
  "dependencies": {
    "@syncmesh/ble": "workspace:*",
    "@syncmesh/client": "workspace:*",
    "@syncmesh/result": "workspace:*",
    "@syncmesh/transports": "workspace:*",
    "@syncmesh/wire": "workspace:*"
  },
  "devDependencies": {
    "@syncmesh/config": "workspace:*",
    "@types/bun": "catalog:",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-network": "~57.0.2",
    "react-native": "0.86.3",
    "react-native-quick-crypto": "^1.1.7",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "expo": ">=53",
    "expo-constants": ">=17",
    "expo-crypto": ">=14",
    "expo-network": ">=7",
    "react-native": ">=0.76",
    "react-native-quick-crypto": ">=1"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    },
    "expo-network": {
      "optional": true
    },
    "react-native-quick-crypto": {
      "optional": true
    }
  }
}
