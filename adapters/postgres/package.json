{
  "name": "@syncmesh/postgres",
  "version": "0.0.0",
  "description": "Postgres as the mesh's log and state: drivers over postgres.js and PGlite for @syncmesh/storage",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@syncmesh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@syncmesh/engine": "workspace:*",
    "@syncmesh/result": "workspace:*",
    "@syncmesh/storage": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@syncmesh/config": "workspace:*",
    "@syncmesh/kernel": "workspace:*",
    "@syncmesh/schema": "workspace:*",
    "@syncmesh/wire": "workspace:*",
    "@types/bun": "catalog:",
    "postgres": "^3.4.9",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.3",
    "postgres": ">=3.4"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  }
}
