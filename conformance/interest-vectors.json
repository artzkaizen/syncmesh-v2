{
  "texts": [
    {
      "description": "no interest is no text",
      "interest": null,
      "text": ""
    },
    {
      "description": "everything",
      "interest": {},
      "text": "{}"
    },
    {
      "description": "partitions alone keep the text they always had",
      "interest": {
        "partitions": ["org:acme"]
      },
      "text": "{\"partitions\":[\"org:acme\"]}"
    },
    {
      "description": "a window is written after the partitions, whatever order the app used",
      "interest": {
        "window": {
          "newest": 50
        },
        "partitions": ["org:acme", "org:globex"]
      },
      "text": "{\"partitions\":[\"org:acme\",\"org:globex\"],\"window\":{\"newest\":50}}"
    },
    {
      "description": "a window alone",
      "interest": {
        "window": {
          "newest": 5
        }
      },
      "text": "{\"window\":{\"newest\":5}}"
    }
  ],
  "read": [
    {
      "description": "junk is no interest",
      "text": "not json",
      "reads": ""
    },
    {
      "description": "a window of none is no window",
      "text": "{\"partitions\":[\"org:acme\"],\"window\":{\"newest\":0}}",
      "reads": "{\"partitions\":[\"org:acme\"]}"
    },
    {
      "description": "a fractional window is no window",
      "text": "{\"window\":{\"newest\":2.5}}",
      "reads": "{}"
    },
    {
      "description": "a window that is not an object is no window",
      "text": "{\"window\":\"lots\"}",
      "reads": "{}"
    },
    {
      "description": "a whole number written with a point is that number",
      "text": "{\"window\":{\"newest\":7.0}}",
      "reads": "{\"window\":{\"newest\":7}}"
    },
    {
      "description": "a field this build does not know is dropped",
      "text": "{\"partitions\":[],\"rank\":1}",
      "reads": "{\"partitions\":[]}"
    }
  ],
  "scopes": [
    {
      "description": "an interest-only scope is the interest's text",
      "interest": "{\"partitions\":[\"org:acme\"]}",
      "entitlement": null,
      "text": "{\"partitions\":[\"org:acme\"]}",
      "reads": {
        "interest": "{\"partitions\":[\"org:acme\"]}",
        "entitlement": null
      }
    },
    {
      "description": "an entitlement follows the window",
      "interest": "{\"partitions\":[\"org:acme\"],\"window\":{\"newest\":50}}",
      "entitlement": "clinic:a",
      "text": "{\"partitions\":[\"org:acme\"],\"window\":{\"newest\":50},\"entitlement\":\"clinic:a\"}",
      "reads": {
        "interest": "{\"partitions\":[\"org:acme\"],\"window\":{\"newest\":50}}",
        "entitlement": "clinic:a"
      }
    },
    {
      "description": "no interest beside an entitlement reads back as none",
      "interest": "",
      "entitlement": "clinic:a",
      "text": "{\"entitlement\":\"clinic:a\"}",
      "reads": {
        "interest": "",
        "entitlement": "clinic:a"
      }
    },
    {
      "description": "a window alone beside an entitlement is an interest",
      "interest": "{\"window\":{\"newest\":5}}",
      "entitlement": "clinic:a",
      "text": "{\"window\":{\"newest\":5},\"entitlement\":\"clinic:a\"}",
      "reads": {
        "interest": "{\"window\":{\"newest\":5}}",
        "entitlement": "clinic:a"
      }
    }
  ],
  "narrows": [
    {
      "description": "an unscoped cursor survives anything",
      "next": "{\"partitions\":[\"org:acme\"],\"window\":{\"newest\":5}}",
      "previous": "",
      "narrows": true,
      "same": false
    },
    {
      "description": "everything again over a slice widens",
      "next": "",
      "previous": "{\"partitions\":[\"org:acme\"]}",
      "narrows": false,
      "same": false
    },
    {
      "description": "dropping a partition narrows",
      "next": "{\"partitions\":[\"org:acme\"]}",
      "previous": "{\"partitions\":[\"org:acme\",\"org:globex\"]}",
      "narrows": true,
      "same": false
    },
    {
      "description": "adding a partition widens",
      "next": "{\"partitions\":[\"org:acme\",\"org:globex\"]}",
      "previous": "{\"partitions\":[\"org:acme\"]}",
      "narrows": false,
      "same": false
    },
    {
      "description": "a smaller window narrows",
      "next": "{\"partitions\":[\"org:acme\"],\"window\":{\"newest\":50}}",
      "previous": "{\"partitions\":[\"org:acme\"],\"window\":{\"newest\":100}}",
      "narrows": true,
      "same": false
    },
    {
      "description": "the same window narrows",
      "next": "{\"partitions\":[\"org:acme\"],\"window\":{\"newest\":50}}",
      "previous": "{\"partitions\":[\"org:acme\"],\"window\":{\"newest\":50}}",
      "narrows": true,
      "same": true
    },
    {
      "description": "windowing an unwindowed slice narrows",
      "next": "{\"partitions\":[\"org:acme\"],\"window\":{\"newest\":50}}",
      "previous": "{\"partitions\":[\"org:acme\"]}",
      "narrows": true,
      "same": false
    },
    {
      "description": "dropping the window widens",
      "next": "{\"partitions\":[\"org:acme\"]}",
      "previous": "{\"partitions\":[\"org:acme\"],\"window\":{\"newest\":50}}",
      "narrows": false,
      "same": false
    },
    {
      "description": "growing the window widens",
      "next": "{\"partitions\":[\"org:acme\"],\"window\":{\"newest\":100}}",
      "previous": "{\"partitions\":[\"org:acme\"],\"window\":{\"newest\":50}}",
      "narrows": false,
      "same": false
    },
    {
      "description": "everything over a window alone widens",
      "next": "{}",
      "previous": "{\"window\":{\"newest\":5}}",
      "narrows": false,
      "same": false
    },
    {
      "description": "the same window in another partition order",
      "next": "{\"partitions\":[\"org:globex\",\"org:acme\"],\"window\":{\"newest\":5}}",
      "previous": "{\"partitions\":[\"org:acme\",\"org:globex\"],\"window\":{\"newest\":5}}",
      "narrows": true,
      "same": true
    }
  ],
